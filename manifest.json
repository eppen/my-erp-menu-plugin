{
  "manifest_version": 3,
  "name": "ERP Menu Layout Modifier",
  "version": "1.1",
  "description": "Modify the menu layout of the ERP system",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://60.190.250.202/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}